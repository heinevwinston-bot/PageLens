{
  "manifest_version": 3,
  "name": "PageLens — AI Page Explainer",
  "version": "1.0.0",
  "description": "Ask an AI questions about the page you're on. PageLens only reads pages — it never clicks, fills, or submits anything for you.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open PageLens"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
